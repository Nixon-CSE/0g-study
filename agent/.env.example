# LLM provider (set per agent in agent.config.json): 'zerog-router' (0G Private Computer), 'zerog' (0G Compute broker) or 'openai-compatible'
LLM_PROVIDER=zerog

# 0G Compute (required when LLM_PROVIDER=zerog)
OG_RPC_URL=https://evmrpc-testnet.0g.ai
DEPLOYER_PRIVATE_KEY=0x...
# Optional: pin to a specific 0G inference provider address (otherwise auto-pick)
OG_BROKER_PROVIDER=

# OpenAI-compatible fallback (required when LLM_PROVIDER=openai-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Embeddings (optional — leave blank to disable vector memory)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=

# Web tools
TAVILY_API_KEY=

# Server
AGENT_API_PORT=7777
LOG_LEVEL=info

# --- 0G Private Computer (router API, TEE-verified, request ids) ---
# Key: https://pc.0g.ai/dashboard/api-keys ; set llm.provider = "zerog-router" in agent.config.json
ZEROG_API_KEY=
ZEROG_LLM_MODEL=deepseek-v4.1-flash          # verified: chat + tool calls. List: GET /v1/models or scripts/smoke-router.mjs
ZEROG_VISION_MODEL=qwen2.5-vl-72b-instruct   # verified: reads a notes photo (read_notes tool)
ZEROG_EMBED_MODEL=qwen3-embedding-0.6b       # study memory (RAG): 1024-dim, batching OK, 32k-token context. Check: scripts/smoke-embeddings.mjs
# ZEROG_BASE_URL=https://router-api.0g.ai/v1

# --- Study Pod hardening (NFR1 / NFR3) ---
# Set to the SAME value as the backend's JWT_SECRET. When set, /uploads, /usage and /study/index
# require the short-lived study token the app gets from GET /v1/auth/study-token. Unset = open (local dev only).
STUDY_JWT_SECRET=
# Comma-separated browser origins allowed to call the study endpoints (empty = any).
STUDY_ALLOWED_ORIGINS=http://localhost:3000
# Per-user daily caps.
STUDY_DAILY_CALL_CAP=30
STUDY_DAILY_UPLOAD_CAP=20
# Router models "think" by default and burn max_tokens; set to "on" to keep thinking enabled.
# ZEROG_THINKING=off

# --- FR9 bonus: users connect their own 0G account ---
# "on" lets a signed-in user store their own sk- API key + read-only mk- management key (encrypted with
# a key derived from STUDY_JWT_SECRET). Their pod calls are billed to them; /study/account reports their balance.
ZEROG_USER_ACCOUNTS=on

# Required in any deployment: guards the agent runtime admin API. Same value in agent + backend.
AGENT_ADMIN_TOKEN=
