# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Privy app ID — get yours at https://console.privy.io
# Required for the Privy auth modal (email, Google, wallet sign-in).
NEXT_PUBLIC_PRIVY_APP_ID=

# BonFire backend base URL (no trailing slash).
# Defaults to http://localhost:8080 when not set.
NEXT_PUBLIC_BONFIRE_BASE_URL=http://localhost:8080

# ember-agent base URL used when creating a new agent (hidden from the UI).
# Defaults to http://localhost:7777 when not set.
NEXT_PUBLIC_AGENT_BASE_URL=http://localhost:7777

# INFT contract on 0G testnet (Galileo, chainId 16602). Set after deploying
# the BonFireAgentINFT contract via `pnpm --filter bonfire-contracts deploy:ogtestnet`.
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_OG_CHAIN_ID=16602

# 0G Private Computer / iAI sign-in: use the 0G-provided Privy app ID above (only works on
# localhost:3000, 3001 or 5173 — demo there). NEXT_PUBLIC_AGENT_BASE_URL above also powers the usage/streak bar.

# Public URL of the deployed app, for Open Graph / Twitter card links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FR9 bonus: let users connect their own 0G account (their sk- key pays for their pod, their
# balance shows in the status bar). Needs ZEROG_USER_ACCOUNTS=on and STUDY_JWT_SECRET on the agent.
NEXT_PUBLIC_ZEROG_ACCOUNTS=on

# Optional: the model label on agent cards (a display string only, never a key). Default "0G Private Computer".
# The real models are the agent runtime's ZEROG_LLM_MODEL / ZEROG_VISION_MODEL; only set this if it matches them.
# NEXT_PUBLIC_AGENT_MODEL_LABEL=deepseek-v4.1-flash · 0G Private Computer
